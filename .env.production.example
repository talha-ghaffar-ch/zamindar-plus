# Copy this file to .env.production on the EC2 server.
# Do not commit the real .env.production file.

# Public HTTPS host created from your Elastic IP.
# Example: APP_HOST=13.203.249.97.sslip.io
APP_HOST=your-elastic-ip.sslip.io
APP_URL=https://your-elastic-ip.sslip.io

# Browser calls the API through Caddy at the same HTTPS origin.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-elastic-ip.sslip.io
JWT_SECRET=replace-with-a-long-random-production-secret

# PostgreSQL — the postgres container in docker-compose.prod.yml.
# POSTGRES_* configure that container; DATABASE_URL must use the same values
# with host "postgres" (the compose service name).
# If you use an external database (e.g. RDS) instead, point DATABASE_URL at it
# and remove the postgres service from docker-compose.prod.yml.
POSTGRES_USER=zamindar
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=zamindar_plus
DATABASE_URL=postgresql://zamindar:replace-with-a-strong-db-password@postgres:5432/zamindar_plus?schema=public

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASSWORD=your-smtp-key
SMTP_FROM="Zamindar Plus <zamindarplus@gmail.com>"

# AI (Google Gemini). The key's project must have billing enabled;
# the free tier returns HTTP 429 (limit: 0) in some regions.
# --- Zamindar AI provider -----------------------------------------------
# The agent works with any chat model that supports tool calling. Pick a
# provider with AI_PROVIDER; the rest of the app does not change.
#
#   gemini      (default) Google Gemini. Uses GEMINI_API_KEY / GEMINI_MODEL.
#   groq        Groq. Very fast, generous free tier.
#   openrouter  OpenRouter. Many models behind one key.
#   together    Together AI.
#   ollama      A model you host yourself (needs ~8 GB RAM for a 7B model).
#   custom      Any other OpenAI-compatible endpoint; set AI_BASE_URL.
#
# For anything other than gemini, set AI_MODEL and AI_API_KEY, e.g.
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
#
# Ollama needs no key:
#   AI_PROVIDER=ollama
#   AI_MODEL=qwen2.5:7b-instruct
#
# AI_TEMPERATURE defaults to 0.15; keep it low so tool calling stays reliable.
AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_TEMPERATURE=0.15

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# Optional one-time seed credentials
SEED_ADMIN_EMAIL=zamindarplus@gmail.com
SEED_ADMIN_PASSWORD=replace-with-a-secure-admin-password
SEED_TEST_EMAIL=test@example.com
SEED_TEST_PASSWORD=replace-with-a-secure-test-password
