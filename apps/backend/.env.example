# Copy this file to apps/backend/.env and fill in as needed.
# The .env file is gitignored — never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Allowed browser origin (the Vite web dev server)
CORS_ORIGIN=http://localhost:5173

# JWT signing secret — any long random string for local development
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL — matches the local docker-compose.yml service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zamindar_plus?schema=public

# Google OAuth (optional locally). The backend verifies the ID-token audience,
# so this must match the web/mobile Google client ID for Google sign-in to work.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email (verification codes + password reset).
# With NODE_ENV=development, the API returns the code in the response
# (devVerificationToken), so you can complete signup WITHOUT email/SMTP.
# To send real email, set EMAIL_DELIVERY_ENABLED=true and fill in the SMTP_* values.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Zamindar Plus <dev@localhost>"

# Zamindar AI (Google Gemini). Optional — only the AI chat needs it.
# The key's Google Cloud project must have a paid/billing-enabled tier;
# the free tier returns HTTP 429 (limit: 0) in some regions.
# --- Zamindar AI provider -----------------------------------------------
# The agent works with any chat model that supports tool calling. Pick a
# provider with AI_PROVIDER; the rest of the app does not change.
#
#   gemini      (default) Google Gemini. Uses GEMINI_API_KEY / GEMINI_MODEL.
#   groq        Groq. Very fast, generous free tier.
#   openrouter  OpenRouter. Many models behind one key.
#   together    Together AI.
#   ollama      A model you host yourself (needs ~8 GB RAM for a 7B model).
#   custom      Any other OpenAI-compatible endpoint; set AI_BASE_URL.
#
# For anything other than gemini, set AI_MODEL and AI_API_KEY, e.g.
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
#
# Ollama needs no key:
#   AI_PROVIDER=ollama
#   AI_MODEL=qwen2.5:7b-instruct
#
# AI_TEMPERATURE defaults to 0.15; keep it low so tool calling stays reliable.
AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_TEMPERATURE=0.15

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
