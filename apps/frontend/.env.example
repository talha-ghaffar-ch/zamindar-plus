# Copy this file to apps/frontend/.env.
# The .env file is gitignored — never commit real secrets.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# Base URL of the backend API (the local NestJS dev server)
VITE_API_URL=http://localhost:3000

# Google OAuth web client ID (optional locally; enables "Continue with Google")
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
